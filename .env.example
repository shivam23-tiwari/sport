# Football Data API (optional - free tier at https://www.football-data.org/client/register)
# Primary football fixtures & standings; falls back to ESPN Soccer public JSON when unset
FOOTBALL_DATA_API_KEY=""

# API-Football (optional - https://dashboard.api-football.com/)
# Secondary football source if FOOTBALL_DATA_API_KEY is not set
API_FOOTBALL_KEY=""

# BallDontLie NBA API (optional - https://app.balldontlie.io/)
# Secondary NBA scores if needed; ESPN NBA public JSON runs automatically
BALLDONTLIE_API_KEY=""

# CricketData.org / CricAPI (optional - https://cricketdata.org/)
# Live cricket scores & detailed match scorecards; falls back to ESPNCricinfo Live RSS when unset
CRICKETDATA_API_KEY=""
# Optional CricketData Series UUID (for series_info & series_points endpoints)
CRICKETDATA_SERIES_ID=""

# Sportmonks Cricket API (optional - https://my.sportmonks.com/)
SPORTMONKS_CRICKET_TOKEN=""

# Gemini API Key (optional - https://aistudio.google.com/apikey)
# Used server-side with Google Search grounding for missing cricket tournament standings
GEMINI_API_KEY=""

# App URL (injected automatically in AI Studio / Cloud Run)
APP_URL=""
